# Copy to .env.local and fill in. Never commit real keys.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or legacy service_role key. Server-only.
SUPABASE_SECRET_KEY=

# Resend → API Keys
RESEND_API_KEY=
# Must be on a domain verified in Resend. For local testing you can use
# "onboarding@resend.dev", which only delivers to your own Resend account email.
RESEND_FROM_EMAIL="NCS SouthEast Summit <registrations@southeastncs.org.ng>"

# Public address of the deployed site. Optional: when set, the confirmation
# email shows the logo and links to the programme.
# SITE_URL=https://southeastncs.org.ng
